---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getChangelogList, PRODUCTS, PRODUCT_LABELS } from '../../lib/changelog';

const entries = await getChangelogList();
const counts = Object.fromEntries(
  PRODUCTS.map((p) => [p, entries.filter((e) => e.data.product === p).length]),
);
---

<BaseLayout title="Changelog - ManyBot" description="Todas as mudanças do ManyBot, ManyPlug e do site.">
  <main class="container container--wide">
    <div class="changelog-hero">
      <h1>Changelog</h1>
      <p>Todas as mudanças do ManyBot, ManyPlug e do site — reunidas em um só lugar.</p>
    </div>

    <div class="changelog-tabs" role="tablist">
      <button class="changelog-tab active" data-tab="all" role="tab" aria-selected="true">
        All <span class="changelog-tab-count">{entries.length}</span>
      </button>
      {PRODUCTS.map((p) => (
        <button class="changelog-tab" data-tab={p} role="tab" aria-selected="false">
          <span class={`changelog-dot changelog-dot--${p}`}></span>
          {PRODUCT_LABELS[p]} <span class="changelog-tab-count">{counts[p]}</span>
        </button>
      ))}
      <button class="changelog-tab" data-tab="plugins" role="tab" aria-selected="false">Plugins</button>

      <a id="changelog-rss" class="rss-link" href="/changelog/rss.xml" target="_blank" rel="noopener">RSS</a>
    </div>

    {entries.length === 0 ? (
      <p class="empty-notice">nenhuma release publicada ainda.</p>
    ) : (
      <ol class="changelog-feed" id="changelog-feed">
        {entries.map((entry) => (
          <li class="changelog-feed-item" data-product={entry.data.product}>
            <a class="changelog-feed-link" href={`/changelog/${entry.data.product}/${entry.data.version}/`}>
              <span class={`changelog-feed-dot changelog-dot--${entry.data.product}`}></span>
              <div class="changelog-feed-body">
                <div class="changelog-feed-top">
                  <span class="changelog-feed-product">{PRODUCT_LABELS[entry.data.product]}</span>
                  <span class="changelog-version">v{entry.data.version}</span>
                  {entry.data.breaking && <span class="changelog-breaking-badge">breaking</span>}
                  <span class="changelog-date">{entry.data.date.toISOString().slice(0, 10)}</span>
                </div>
                {entry.data.excerpt && <div class="changelog-item-excerpt">{entry.data.excerpt}</div>}
              </div>
            </a>
          </li>
        ))}
      </ol>
    )}

    <div class="changelog-plugins-panel" id="changelog-plugins-panel" hidden>
      <h2>Changelog de plugins</h2>
      <p>Mantém um plugin publicado? Manda a changelog dele pra gente revisar e publicar aqui.</p>
      <a class="link-card" href="mailto:manybot@pm.me?subject=Changelog%20de%20plugin">
        <svg class="link-card-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="3" y="6" width="18" height="12" rx="2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M20.5737 7L12 13L3.42635 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div>
          <div class="link-card-title">Mandar um email</div>
          <div class="link-card-desc">manybot@pm.me</div>
        </div>
        <span class="link-card-arrow">→</span>
      </a>
    </div>
  </main>
</BaseLayout>

<script>
  const RSS_HREFS: Record<string, string> = {
    all: '/changelog/rss.xml',
    manybot: '/changelog/manybot/rss.xml',
    manyplug: '/changelog/manyplug/rss.xml',
    website: '/changelog/website/rss.xml',
  };

  const tabs = document.querySelectorAll<HTMLButtonElement>('.changelog-tab');
  const items = document.querySelectorAll<HTMLLIElement>('.changelog-feed-item');
  const feed = document.getElementById('changelog-feed');
  const pluginsPanel = document.getElementById('changelog-plugins-panel');
  const rss = document.getElementById('changelog-rss') as HTMLAnchorElement | null;

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      tabs.forEach((t) => {
        t.classList.remove('active');
        t.setAttribute('aria-selected', 'false');
      });
      tab.classList.add('active');
      tab.setAttribute('aria-selected', 'true');

      const key = tab.dataset.tab ?? 'all';

      if (key === 'plugins') {
        feed?.setAttribute('hidden', '');
        pluginsPanel?.removeAttribute('hidden');
        rss?.setAttribute('hidden', '');
        return;
      }

      pluginsPanel?.setAttribute('hidden', '');
      feed?.removeAttribute('hidden');
      if (rss) {
        rss.removeAttribute('hidden');
        rss.href = RSS_HREFS[key] ?? RSS_HREFS.all;
      }

      items.forEach((item) => {
        if (key === 'all' || item.dataset.product === key) {
          item.removeAttribute('hidden');
        } else {
          item.setAttribute('hidden', '');
        }
      });
    });
  });
</script>


---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChangelogContent from '../../../components/ChangelogContent.astro';
import { CHANGELOG_TABS, PRODUCT_LABELS, type ChangelogTab, type Product } from '../../../lib/changelog';

export async function getStaticPaths() {
  return CHANGELOG_TABS.filter((tab) => tab !== 'all').map((product) => ({ params: { product } }));
}

const { product } = Astro.params as { product: Exclude<ChangelogTab, 'all'> };
const label = product === 'plugins' ? 'Plugins' : PRODUCT_LABELS[product as Product];
const description =
  product === 'plugins' ? 'Changelog de plugins do ManyBot.' : `Histórico de releases do ${label}.`;
---

<BaseLayout title={`Changelog · ${label} - ManyBot`} description={description}>
  <main class="container container--wide">
    <ChangelogContent initialTab={product} />
  </main>
</BaseLayout>

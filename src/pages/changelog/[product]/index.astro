---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getChangelogList, PRODUCTS, PRODUCT_LABELS, type Product } from '../../../lib/changelog';

export async function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { product } }));
}

const { product } = Astro.params as { product: Product };
const label = PRODUCT_LABELS[product];
const entries = await getChangelogList(product);
---

<BaseLayout
  title={`Changelog · ${label} - ManyBot`}
  description={`Histórico de releases do ${label}.`}
>
  <main class="container">
    <a class="back-link" href="/changelog/">← changelog</a>

    <div class="blog-header">
      <h1>Changelog · {label}</h1>
      <a class="rss-link" href={`/changelog/${product}/rss.xml`} target="_blank" rel="noopener">RSS</a>
    </div>

    {entries.length === 0 ? (
      <p class="empty-notice">nenhuma release publicada ainda.</p>
    ) : (
      <ul class="changelog-list">
        {entries.map((entry) => (
          <li>
            <a class="changelog-item" href={`/changelog/${product}/${entry.data.version}/`}>
              <div class="changelog-item-top">
                <span class="changelog-version">v{entry.data.version}</span>
                <span class="changelog-date">{entry.data.date.toISOString().slice(0, 10)}</span>
                {entry.data.breaking && <span class="changelog-breaking-badge">breaking</span>}
              </div>
              {entry.data.excerpt && <div class="changelog-item-excerpt">{entry.data.excerpt}</div>}
            </a>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>


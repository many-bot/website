---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dictionaries, base, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaries[locale].home;
const b = base(locale);
---

<BaseLayout title={t.title} description={t.description} bodyClass="page-home">
  <main>
    <div class="hero">
      <div class="hero-inner">
        <img class="hero-logo" src="/assets/manybot-logo.svg" alt="ManyBot" />
        <h1 class="hero-tagline">{t.tagline}</h1>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/docs/getting-started/">{t.getStarted}</a>
          <a class="btn btn-secondary" href="https://wa.manybot.org">{t.joinCommunity}</a>
        </div>
        <img class="home-mascot" src="/assets/many-art-forever-friendship.png" alt="ManyBot Mascot">
      </div>
    </div>

    <div class="container">
<section class="features">
          <h2>Principais Recursos</h2>
          <ul class="feature-list">
            <li><strong>Core Framework:</strong> Base robusta e modular para bots de WhatsApp.</li>
            <li><strong>ManyPlug:</strong> Instalação de plugins em tempo real sem downtime.</li>
            <li><strong>Modularidade:</strong> Lógica de negócio separada da infraestrutura.</li>
            <li><strong>Performance:</strong> Baixa latência e alta concorrência.</li>
            <li><strong>Open Source:</strong> Transparente, auditável e comunitário.</li>
          </ul>
        </section>

      <div class="code-section">
        <h2>Exemplo de plugin (API estável)</h2>
          <div class="code-window">
            <pre><code set:html={`// plugins/meu-plugin/index.js

export async function setup(ctx) {
  ctx.log.info("meu‑plugin inicializado!");
}

export default async function (ctx) {
  if (ctx.msg.is("oi")) {
    await ctx.send.text("Olá, mundo!");
  }
}`}"/></pre>
          </div>
      </div>

      <div class="home-footer-links">
        <a href="/docs/">Documentação</a>
        <a href="/plugins/">Plugins</a>
        <a href="/colabore/">Colabore</a>
        <a href="/donates/">Doações</a>
      </div>
    </div>
  </main>
</BaseLayout>


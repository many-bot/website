---
import BaseLayout from '../layouts/BaseLayout.astro';
import { dictionaries, base, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dictionaries[locale].home;
const b = base(locale);
---

<BaseLayout title={t.title} description={t.description} bodyClass="page-home">
  <main>
    <div class="hero">
      <div class="hero-inner">
        <div class="hero-text">
          <img class="hero-logo" src="/assets/manybot-logo.svg" alt="ManyBot" />
          <p class="hero-tagline">{t.tagline}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/docs/getting-started/">{t.getStarted}</a>
            <a class="btn btn-secondary" href="https://wa.manybot.org">{t.joinCommunity}</a>
          </div>
        </div>
        <img class="home-mascot" src="/assets/many-art-forever-friendship.png">
      </div>

      <div class="hero-scroll-indicator" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6" />
        </svg>
      </div>
    </div>

    <div class="container">
      <div class="home-community">
        <p>{t.newHerePrefix} <a href="https://wa.manybot.org">{t.newHereLink}</a> {t.newHereSuffix}</p>
      </div>

      <div class="home-cards">
        <div class="home-card">
          <div class="home-card-label">{t.tryNowLabel}</div>
          <p>{t.tryNowText}</p>
          <a class="btn btn-primary" href="https://wa.me/5516994591903">{t.tryNowCta}</a>
          <p><a href={`${b}/docs/terms-and-privacy/`}>{t.termsLink}</a></p>
        </div>

        <div class="home-card">
          <div class="home-card-label">{t.hostLabel}</div>
          <p>{t.hostText}</p>
          <a class="btn btn-ghost" href={`${b}/docs/`}>{t.hostCta}</a>
        </div>

        <div class="home-card">
          <div class="home-card-label">{t.extensibleLabel}</div>
          <p>{t.extensibleText}</p>
          <a class="btn btn-ghost" href={`${b}/plugins/`}>{t.pluginsCta}</a>
          <a class="btn btn-ghost" href={`${b}/docs/api/`}>{t.apiCta}</a>
        </div>
      </div>

      <div class="home-honest">
        <p><strong>{t.whatIsTitle}</strong><br />{t.whatIsText}</p>
        <p>{t.openSourceText} <a href={`${b}/colabore/`}>{t.contributionsLink}</a> {t.contributionsSuffix} <a href={`${b}/donates/`}>{t.donateLink}</a>.</p>
      </div>

      <div class="home-honest">
        <p><strong>{t.goalTitle}</strong><br />{t.goalText}</p>
      </div>
    </div>
  </main>
</BaseLayout>


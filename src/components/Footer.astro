---
import { dictionaries, base, type Locale } from '../i18n';
import SocialIcon from './SocialIcon.astro';

interface Props {
  locale: Locale;
  mini?: boolean;
}

const { locale, mini = true } = Astro.props;
const b = base(locale);
const miniT = dictionaries[locale].footerMini;
const fullT = dictionaries[locale].footer;
---

{mini ? (
  <footer class="footer-mini">
    <div class="footer-mini-inner">
      <a class="footer-mini-brand" href={`${b}/`} aria-label="ManyBot">
        <img src="/assets/icon-white.png" alt="">
      </a>
      <span class="footer-mini-copy">{miniT.copy}</span>
      <nav class="footer-mini-links">
        <a href={`${b}/docs/`}>{miniT.docs}</a>
        <a href="https://github.com/many-bot/manybot" target="_blank" rel="noopener">GitHub</a>
        <a href="https://discord.gg/gC7aKChXmA" target="_blank" rel="noopener">{miniT.discord}</a>
        <a href={`${b}/legal/`}>{miniT.legal}</a>
      </nav>
    </div>
  </footer>
) : (
  <footer>
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-brand">
          <a href={`${b}/`}><img src="/assets/icon-white.png" /></a>
        </div>
        <div class="footer-brand">
          <a href="https://feitonobrasil.dev.br" aria-label="Feito no Brasil">
            <img src="https://selo.feitonobrasil.dev.br/pt-br/custom/0.5x.svg?color=%23f6f5f4" alt="Feito no Brasil" width="250" height="120" loading="lazy" />
          </a>
        </div>
        <div class="footer-cols">
          <div class="footer-col">
            <div class="footer-col-title">{fullT.projectTitle}</div>
            <a href={`${b}/blog/`}>{fullT.blog}</a>
            <a href={`${b}/plugins/`}>{fullT.plugins}</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-title">{fullT.resourcesTitle}</div>
            <a href="https://github.com/many-bot/manybot" target="_blank" rel="noopener">{fullT.sourceCode}</a>
            <a href={`${b}/docs/`}>{fullT.docs}</a>
            <a href="https://github.com/many-bot/manybot/releases" target="_blank" rel="noopener">{fullT.releases}</a>
            <a href="/rss.xml" target="_blank" rel="noopener">{fullT.rss}</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-title">{fullT.communityTitle}</div>
            <a href={`${b}/fanarts/`}>{fullT.fanarts}</a>
            <a href="https://wa.manybot.org" target="_blank" rel="noopener">{fullT.whatsapp}</a>
            <a href="https://discord.gg/gC7aKChXmA" target="_blank" rel="noopener">{fullT.discord}</a>
            <a href="https://mastodon.social/@manybot" target="_blank" rel="noopener">{fullT.mastodon}</a>
            <a href="https://youtube.com/@manybotyt" target="_blank" rel="noopener">{fullT.youtube}</a>
          </div>
          <div class="footer-col">
            <div class="footer-col-title">{fullT.contactTitle}</div>
            <a href="mailto:manybot@pm.me">{fullT.email}</a>
          </div>
        </div>
      </div>
      <div class="footer-bottom">
        <span>{fullT.copy}</span>
        <div class="footer-legal">
          <span>{fullT.noCookies}</span>
          <a href={`${b}/legal/`}>{fullT.legal}</a>
        </div>
        <div class="footer-social">
          <a href="https://github.com/many-bot" target="_blank" rel="noopener" aria-label="GitHub">
            <SocialIcon name="github" />
          </a>
          <a href="https://codeberg.org/many-bot" target="_blank" rel="noopener" aria-label="Codeberg">
            <SocialIcon name="codeberg" />
          </a>
          <a href="/rss.xml" target="_blank" rel="noopener" aria-label="RSS">
            <SocialIcon name="rss" />
          </a>
        </div>
      </div>
    </div>
  </footer>
)}


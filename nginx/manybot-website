        default-src 'self';
        script-src 'self'
            'sha256-igwz3KwQywC+fV+rpLO+LxA4SZvpuJSr3MOMptfbFjk='
            'sha256-024W+/XGCRSbnZsGBbjJ8RHt2pFHRfUKtJ07YRxuYrg='

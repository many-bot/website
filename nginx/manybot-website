            'sha256-Sv9N59lsuXe5lk97aOAQzvj3ka8D7flaCn415gjwNzs=';
        style-src 'self' 'unsafe-inline' https://fonts.googleapis.com;
        font-src 'self' https://fonts.gstatic.com;
        img-src 'self' data:;
        connect-src 'self' https://api.manybot.org;
        object-src 'none';
        base-uri 'self';
        frame-ancestors 'self';
    " always;

    root /srv/manybot-webpage/dist;
    index index.html;

    error_page 404 /404.html;
    error_page 403 /403.html;
    error_page 500 /500.html;
    error_page 503 /503.html;

    location = /404.html { internal; }
    location = /403.html { internal; }
    location = /500.html { internal; }
    location = /503.html { internal; }

    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /pagefind/ {
        expires 1d;
    }

    ssl_certificate /etc/letsencrypt/live/manybot.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/manybot.org/privkey.pem; # managed by Certbot
}


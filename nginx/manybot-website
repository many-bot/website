server {
    server_name manybot.stxerr.dev;
    listen 443 ssl; # managed by Certbot

    # Mantemos os certificados do antigo para o handshake SSL funcionar antes do redirect
    ssl_certificate /etc/letsencrypt/live/manybot.stxerr.dev/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/manybot.stxerr.dev/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    # Redireciona tudo permanentemente para o domínio novo com HTTPS
    return 301 https://manybot.org$request_uri;
}

server {
    listen 80;
    server_name manybot.stxerr.dev;

    # Se alguém acessar via HTTP antigo, já vai direto para o HTTPS novo
    return 301 https://manybot.org$request_uri;
}

server {
    listen 80;
    server_name manybot.org www.manybot.org;

    return 301 https://manybot.org$request_uri;
}

server {
    listen 443 ssl;
    server_name manybot.org www.manybot.org;

    # --- Segurança: HSTS ---
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # --- Segurança: Content-Security-Policy ---

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "product": {
      "type": "string",
      "enum": [
        "manybot",
        "many",
        "manyplug",
        "website"
      ]
    },
    "version": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "excerpt": {
      "type": "string"
    },
    "breaking": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "product",
    "version",
    "date"
  ]
}